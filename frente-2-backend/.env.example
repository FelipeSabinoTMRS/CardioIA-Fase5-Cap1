# Credenciais do IBM watsonx Assistant (Service credentials da instância no IBM Cloud)
WA_API_KEY=
WA_URL=https://api.us-south.assistant.watson.cloud.ibm.com
# Assistant settings -> "Assistant IDs and API details" -> View details
WA_ASSISTANT_ID=
# Environment ID (draft ou live). Se ficar vazio, o backend usa a rota antiga só com o assistant ID.
WA_ENVIRONMENT_ID=
# Versão da API v2 (data), igual ao material da disciplina
WA_VERSION=2021-06-14
FLASK_PORT=5050
