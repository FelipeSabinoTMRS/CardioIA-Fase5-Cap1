# Banco relacional (SQLite). Caminho relativo à pasta frente-5-ir-alem-2.
SQLITE_PATH=dados/cardioia_rpa.db

# Banco não relacional (MongoDB). Usuário e senha iguais aos do docker-compose.yml.
# Troque a senha se o banco não for só local.
MONGO_USUARIO=admin
MONGO_SENHA=admin
MONGO_URI=mongodb://admin:admin@localhost:27017/?authSource=admin
MONGO_DB=cardioia_rpa

# Vocabulário de entidades da skill Watson (Frente 1).
SKILL_WATSON_PATH=../frente-1-watson/cardioia-skill.json
